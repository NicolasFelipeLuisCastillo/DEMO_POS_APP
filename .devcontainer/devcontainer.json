{
  "name": "Suma Tauri",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "shell",
  "workspaceFolder": "/app",
  "customizations": {
    "vscode": {
      "extensions": [
        "tauri-apps.tauri-vscode",
        "rust-lang.rust-analyzer",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "rust-analyzer.cargo.features": "all"
      }
    }
  },
  "remoteUser": "root",
  "postCreateCommand": "npm ci"
}
